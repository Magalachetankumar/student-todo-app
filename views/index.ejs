<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student To-Do App</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📚 Student To-Do App</h1>
            <p>Keep track of your assignments and tasks</p>
        </header>

        <div class="add-todo">
            <form action="/add" method="POST">
                <input 
                    type="text" 
                    name="title" 
                    placeholder="Add a new task..." 
                    required
                    autofocus
                >
                <button type="submit">Add Task</button>
            </form>
        </div>

        <div class="stats">
            <p>Total Tasks: <strong><%= todos.length %></strong></p>
            <p>Completed: <strong><%= todos.filter(t => t.completed).length %></strong></p>
            <p>Pending: <strong><%= todos.filter(t => !t.completed).length %></strong></p>
        </div>

        <div class="todos">
            <% if (todos.length === 0) { %>
                <p class="empty">No tasks yet! You're all caught up! 🎉</p>
            <% } else { %>
                <% todos.forEach(todo => { %>
                    <div class="todo-item <%= todo.completed ? 'completed' : '' %>">
                        <div class="todo-content">
                            <form action="/toggle/<%= todo.id %>" method="POST" class="toggle-form">
                                <input 
                                    type="checkbox" 
                                    <%= todo.completed ? 'checked' : '' %>
                                    onchange="this.form.submit()"
                                >
                            </form>
                            <span class="todo-text"><%= todo.title %></span>
                        </div>
                        <form action="/delete/<%= todo.id %>" method="POST" class="delete-form">
                            <button type="submit" class="delete-btn">Delete</button>
                        </form>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</body>
</html>
